# Server-side secrets. Load with:  supabase secrets set --env-file supabase/.env
# (never commit the real .env file)

# ---- AI extraction (supabase/functions/extract) ----
AI_PROVIDER=gemini               # gemini | anthropic | openai  ("openai" = any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest # gemini-flash-lite-latest | gemini-flash-latest | claude-sonnet-5
# Only for AI_PROVIDER=openai. Examples:
#   OpenAI:  https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:    https://api.groq.com/openai/v1
AI_BASE_URL=

# ---- Speech to text (supabase/functions/transcribe) ----
SPEECH_PROVIDER=gemini           # gemini | whisper
SPEECH_API_KEY=
SPEECH_MODEL=gemini-flash-lite-latest
# Only needed for SPEECH_PROVIDER=whisper:
SPEECH_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
